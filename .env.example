# ========================================================
# StudioSpace Backend Server — Environment Variables
# ========================================================
# Copy this file to .env for local development.
# On Render (Production): Configure these in Render Dashboard -> Environment.
# NEVER commit real credentials or .env to version control.

# Server Port
# - Local dev: 5000
# - Render: Automatically provided by Render via process.env.PORT
PORT=5000

# Runtime Environment (development | production | test)
# - Local dev: development
# - Render: production (required for secure cross-site cookies & production optimizations)
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local MongoDB)
# - Local dev: mongodb://localhost:27017/studiospace
# - Render: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/studiospace?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/studiospace?retryWrites=true&w=majority

# JWT Authentication Secret
# Provide a strong, high-entropy secret string (minimum 32 characters)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# JWT Token Expiration (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# CORS Allowed Origin for Frontend Client
# - Local dev: http://localhost:3000
# - Render: https://studiospace-client-nine.vercel.app
CLIENT_URL=http://localhost:3000
