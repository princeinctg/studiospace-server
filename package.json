{
  "name": "studiospace-server",
  "version": "1.0.0",
  "description": "StudioSpace Backend API Server — Studio Booking, Auth & Management",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "postinstall": "npm run build",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "seed": "ts-node-dev --transpile-only src/seed/seed.ts",
    "lint": "tsc --noEmit",
    "check-casing": "node scripts/check-casing.js"
  },
  "keywords": [
    "studiospace",
    "api",
    "express",
    "typescript",
    "mongodb"
  ],
  "author": "Prince",
  "license": "ISC",
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.8.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.3",
    "morgan": "^1.10.0",
    "serverless-http": "^4.0.0",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0"
  }
}
